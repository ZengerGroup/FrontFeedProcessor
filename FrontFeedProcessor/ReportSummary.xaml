<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FrontFeedProcessor.ReportSummary">
    <Border Stroke="Blue">
        <Grid RowDefinitions="25,25,25,25,25,25,25,25" ColumnDefinitions="50,50,50,50,50,50,50,50,50,50,50,50">
            <Label Text="Summary" Grid.Row="1" Grid.Column="6" Grid.ColumnSpan="2"/>
            <Label Text="Mailing Segment:" Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" />
            <Label x:Name="MailingSegmentData" Grid.Row="2" Grid.Column="5" Grid.ColumnSpan="7" />
            <Label Text="Class of Postage:" Grid.Row="3" Grid.Column="2" Grid.ColumnSpan="2" />
            <Label x:Name="ClassOfPostageData" Grid.Row="3" Grid.Column="5" Grid.ColumnSpan="7" />
            <Label Text="Zenger Job Number:" Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="2" />
            <Label x:Name="ZGJobNumberData" Grid.Row="4" Grid.Column="5" Grid.ColumnSpan="7" />
            <Label Text="Report Path:" Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" />
            <Label x:Name="ReportPathData" Grid.Row="5" Grid.Column="5" Grid.ColumnSpan="7" />
            <Label Text="Other Warnings:" Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="2" />
            <Label x:Name="WarningData" Grid.Row="6" Grid.Column="5" Grid.ColumnSpan="7" />
        </Grid>
    </Border>
</ContentView>
