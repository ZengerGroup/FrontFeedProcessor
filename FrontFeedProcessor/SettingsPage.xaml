<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FrontFeedProcessor.SettingsPage"
             Title="SettingsPage">
    <Grid RowDefinitions="25,25,25,25,25,25,25,25,25,25,25,25,25,25" ColumnDefinitions="50,550,150,50">
        <Label Text="GPG Decryption Program Path" Grid.Row="1" Grid.Column="1"/>
        <Button x:Name="GpgPathButton" Text="Select" Grid.Row="1" Grid.Column="2" Clicked="GpgPathButton_Clicked" MinimumHeightRequest="25" Padding="0"/>
        <Border Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2">
            <Label x:Name="GpgPathData" />
        </Border>
        <Label Text="GPG Private Key" Grid.Row="3" Grid.Column="1"/>
        <Button x:Name="PriKeyPathButton" Text="Select" Grid.Row="3" Grid.Column="2" Clicked="PriKeyPathButton_Clicked" MinimumHeightRequest="25" Padding="0"/>
        <Border Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2">
            <Label x:Name="PriKeyPathData" />
        </Border>
        <Label Text="GPG Public Key" Grid.Row="5" Grid.Column="1"/>
        <Button x:Name="PubKeyPathButton" Text="Select" Grid.Row="5" Grid.Column="2" Clicked="PubKeyPathButton_Clicked" MinimumHeightRequest="25" Padding="0"/>
        <Border Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2">
            <Label x:Name="PubKeyPathData" />
        </Border>
        <Label Text="GPG Secret String" Grid.Row="7" Grid.Column="1"/>
        <Button x:Name="SecretStringButon" Text="Set" Grid.Row="7" Grid.Column="2" Clicked="SecretStringButon_Clicked" MinimumHeightRequest="25" Padding="0"/>
        <Border Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2">
            <Label x:Name="SecretStringData" />
        </Border>
        <Label Text="Log Directory Path" Grid.Row="9" Grid.Column="1" />
        <Button x:Name="LogPathButton" Text="Set" Grid.Row="9" Grid.Column="2" Clicked="LogPathButton_Clicked" MinimumHeightRequest="25" Padding="0"/>
        <Border Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2">
            <Label x:Name="LogPathData" />
        </Border>
        <Label Text="Archive Path" Grid.Row="11" Grid.Column="1" />
        <Button x:Name="ArchivePathButton" Text="Set" Grid.Row="11" Grid.Column="2" Clicked="ArchivePathButton_Clicked" MinimumHeightRequest="25" Padding="0"/>
        <Border Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2">
            <Label x:Name="ArchivePathData" />
        </Border>
    </Grid>
</ContentPage>